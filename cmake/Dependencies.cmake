function(dcpp_c_library name directory pattern)
    file(GLOB sources CONFIGURE_DEPENDS "${DCPP_ROOT}/${directory}/${pattern}")
    add_library(${name} STATIC ${sources})
    target_link_libraries(${name} PRIVATE dcpp_options)
    target_include_directories(${name} PUBLIC "${DCPP_ROOT}/${directory}")
    set_target_properties(${name} PROPERTIES FOLDER Dependencies)
endfunction()

dcpp_c_library(zlib zlib "*.c")
target_compile_definitions(zlib PRIVATE NOUNCRYPT)
file(GLOB_RECURSE zstd_sources CONFIGURE_DEPENDS "${DCPP_ROOT}/zstd/*.c")
add_library(zstd STATIC ${zstd_sources})
target_link_libraries(zstd PRIVATE dcpp_options)
target_include_directories(zstd PUBLIC "${DCPP_ROOT}/zstd/lib" PRIVATE "${DCPP_ROOT}/zstd/lib/common")
target_compile_definitions(zstd PRIVATE ZSTD_DISABLE_ASM ZSTD_LEGACY_SUPPORT=0)
set_target_properties(zstd PROPERTIES FOLDER Dependencies)
dcpp_c_library(sqlite sqlite sqlite3.c)
target_compile_definitions(sqlite PRIVATE SQLITE_DQS=0 SQLITE_DEFAULT_FOREIGN_KEYS=1
    SQLITE_DEFAULT_MEMSTATUS=0 SQLITE_DEFAULT_WAL_SYNCHRONOUS=1 SQLITE_ENABLE_API_ARMOR=1
    SQLITE_LIKE_DOESNT_MATCH_BLOBS=1 SQLITE_MAX_ALLOCATION_SIZE=67108864
    SQLITE_OMIT_DEPRECATED=1 SQLITE_OMIT_LOAD_EXTENSION=1 SQLITE_OMIT_SHARED_CACHE=1
    SQLITE_PRINTF_PRECISION_LIMIT=100000 SQLITE_THREADSAFE=1 SQLITE_TRUSTED_SCHEMA=0 SQLITE_USE_URI=0)
dcpp_c_library(bzip2 bzip2 "*.c")
dcpp_c_library(maxminddb maxminddb "*.c")
target_compile_definitions(maxminddb PRIVATE PACKAGE_VERSION="1.14.1")
dcpp_c_library(miniupnpc miniupnpc "*.c")
target_compile_definitions(miniupnpc PRIVATE MINIUPNP_STATICLIB WIN32)
# Consumers include <miniupnpc/...> through the repository root. Exporting this
# directory would make its text file named "version" shadow C++'s <version>.
set_property(TARGET miniupnpc PROPERTY INTERFACE_INCLUDE_DIRECTORIES "")
dcpp_c_library(natpmp natpmp "*.c")
target_compile_definitions(natpmp PRIVATE "errno=WSAGetLastError()" STATICLIB NATPMP_STATICLIB WIN32)
set_property(TARGET natpmp PROPERTY INTERFACE_INCLUDE_DIRECTORIES "")
dcpp_c_library(md4c md4c "*.c")

if(MINGW AND DCPP_ARCH STREQUAL "x64")
    set(intl_root "${DCPP_ROOT}/intl/modern")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${intl_root}/sources.txt")
    file(STRINGS "${intl_root}/sources.txt" intl_sources REGEX "^[^#].+")
    list(TRANSFORM intl_sources PREPEND "${intl_root}/")
    add_library(aintl STATIC ${intl_sources})
    target_include_directories(aintl BEFORE PRIVATE "${intl_root}" "${intl_root}/gnulib-lib")
    target_compile_definitions(aintl PRIVATE HAVE_CONFIG_H BUILDING_LIBINTL BUILDING_LIBRARY
        __USE_MINGW_ANSI_STDIO=0 LOCALEDIR="" LIBDIR="")
    target_link_libraries(aintl PRIVATE dcpp_options)
else()
    dcpp_c_library(aintl intl "*.c")
    target_compile_definitions(aintl PRIVATE LOCALEDIR="" LOCALE_ALIAS_PATH="" INSTALLDIR="" LIBDIR=""
        IN_LIBINTL ENABLE_RELOCATABLE=1 NO_XMALLOC HAVE_CONFIG_H
        set_relocation_prefix=libintl_set_relocation_prefix relocate=libintl_relocate)
endif()
target_include_directories(aintl INTERFACE "${DCPP_ROOT}/intl")
set_target_properties(aintl PROPERTIES FOLDER Dependencies)
if(MINGW)
    dcpp_c_library(dwarf dwarf "*.c")
    target_compile_definitions(dwarf PRIVATE WIN32 SHT_RELA=4 LIBDWARF_STATIC)
    target_link_libraries(dwarf PUBLIC zlib)
endif()

# Explicit bundled locations prevent silently selecting a different OpenSSL ABI.
set(DCPP_OPENSSL_ROOT "${DCPP_ROOT}/openssl" CACHE PATH "OpenSSL headers and libraries")
if(MINGW)
    set(ssl_file libssl.a)
    set(crypto_file libcrypto.a)
else()
    set(ssl_file libssl.lib)
    set(crypto_file libcrypto.lib)
endif()
foreach(component IN ITEMS ssl crypto)
    set(library "${DCPP_OPENSSL_ROOT}/lib${DCPP_LIB_SUFFIX}/${${component}_file}")
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "Missing OpenSSL library: ${library}")
    endif()
    add_library(openssl_${component} UNKNOWN IMPORTED)
    set_target_properties(openssl_${component} PROPERTIES IMPORTED_LOCATION "${library}"
        INTERFACE_INCLUDE_DIRECTORIES "${DCPP_OPENSSL_ROOT}/include")
endforeach()
target_link_libraries(openssl_ssl INTERFACE openssl_crypto)
target_link_libraries(openssl_crypto INTERFACE crypt32 ws2_32)
