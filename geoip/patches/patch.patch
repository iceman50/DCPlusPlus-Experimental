+#ifdef _WIN32
+/* DC++ integration: preserve Unicode database paths for open and cache reload. */
+static wchar_t *GeoIP_native_path(const char *path) {
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);
+    wchar_t *native;
+    if (!length) return NULL;
+    native = (wchar_t *)malloc((size_t)length * sizeof(wchar_t));
+    if (!native) return NULL;
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, native, length)) {
+        free(native);
+        return NULL;
+    }
+    return native;
+}
+static FILE *GeoIP_fopen(const char *path, const char *mode) {
+    wchar_t *native = GeoIP_native_path(path);
+    FILE *file;
+    (void)mode; /* All callers open databases for binary reads. */
+    if (!native) return NULL;
+    file = _wfopen(native, L"rb");
+    free(native);
+    return file;
+}
+static int GeoIP_stat(const char *path, struct stat *result) {
+    wchar_t *native = GeoIP_native_path(path);
+    struct _stat info;
+    int status;
+    if (!native) return -1;
+    status = _wstat(native, &info);
+    free(native);
+    if (status == 0) {
+        memset(result, 0, sizeof(*result));
+        result->st_size = info.st_size;
+        result->st_mtime = info.st_mtime;
+    }
+    return status == 0 ? 0 : -1;
+}
+#define fopen GeoIP_fopen
+#define stat(path, result) GeoIP_stat(path, result)
+#endif
