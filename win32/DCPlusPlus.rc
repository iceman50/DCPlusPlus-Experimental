//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,8,8,42
 PRODUCTVERSION 0,8,8,42
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "https://github.com/iceman50/DCPlusPlus-No-MDI"
            VALUE "FileDescription", "DC++"
            VALUE "FileVersion", "0, 8, 8, 42"
            VALUE "InternalName", "DC++"
            VALUE "LegalCopyright", "Copyright 2001-2026 iceman50"
            VALUE "OriginalFilename", "DCPlusPlus.exe"
            VALUE "ProductName", "DC++"
            VALUE "ProductVersion", "0, 8, 8, 42"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

