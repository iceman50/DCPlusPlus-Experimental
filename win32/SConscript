# vim: set filetype=py

Import("dev source_path")

env, target, sources = dev.prepare_build(
    source_path, "DCPlusPlus", precompiled_header="stdafx"
)

dev.add_boost(env)
dev.add_crashlog(env)
dev.add_dcpp(env)
dev.add_intl(env)
dev.add_openssl(env)

if dev.is_win32():
    env.Append(CPPPATH=["#/dwt/include"])
    env.Append(
		LIBS=[
			"comctl32",
			"comdlg32",
			"ole32",
			"oleaut32",
            "shlwapi",
            "windowscodecs",
            "uuid",
            "uxtheme",
            "winmm",
            "wtsapi32",
            "dwmapi",
            "psapi",
            "winhttp",
            "crypt32",
        ]
    )

if "HAVE_HTMLHELP_H" in env["CPPDEFINES"]:
    env.Append(LIBS=["htmlhelp"])

prog_sources = sources

if dev.is_win32():
    if env["RC"] == "rc":  # MSVC
        env.Append(RCFLAGS=["/d" + env["arch"]])
    elif env["RC"].find("windres") != -1:  # MinGW
        env.Append(RCFLAGS=["-D" + env["arch"]])
    else:
        print("Unknown resource compiler.")
        Return()
    res = env.RES(dev.get_sources(source_path, "*.rc"))
    env.Depends(res, ["resource.h", "#/res/DCPlusPlus.manifest." + env["arch"]])
    env.Depends(res, ["CountryFlags.rc.inc", dev.get_sources("res/flags/", "*.ico")])
    prog_sources.append(res)

headers = dev.get_sources(source_path, "*.h")
dev.i18n(source_path, env, [sources, headers], "dcpp-win32")

if env["msvcproj"]:
    ret = dev.build_lib(env, target, sources, dev.cpp_lib)
else:
    if "gcc" in env["TOOLS"]:
        linked = dev.build_program(env,
            dev.get_target(source_path, "DCPlusPlus-unstripped", in_bin=False),
            prog_sources)
        ret = dev.split_debug_info(env, target, linked)
    else:
        ret = dev.build_program(env, target, prog_sources)
    # The root test/win32 build reuses these exact production objects and flags.
    import os
    dev.win32_test_env = env
    dev.win32_test_sources = [s for s in sources if os.path.basename(str(s)) != "main.cpp"]

Return("ret")
